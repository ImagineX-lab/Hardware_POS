# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnp
.pnp.js

# ── Database (local SQLite — never commit live data) ──────────────────────────
backend/pos.db
backend/pos.db-shm
backend/pos.db-wal
*.db
*.sqlite
*.sqlite3

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build Output ──────────────────────────────────────────────────────────────
dist/
build/
out/

# ── OS Files ──────────────────────────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ── Editor / IDE ──────────────────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*.bak

# ── Backup Files (user-generated downloads) ───────────────────────────────────
*.backup.json
backup_*.json

# ── Misc ──────────────────────────────────────────────────────────────────────
.cache/
.temp/