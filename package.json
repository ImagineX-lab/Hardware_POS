{
  "name": "hardware-pos",
  "version": "1.0.0",
  "description": "Hardware (කඩේ) සාප්පුවක් සඳහා නිර්මාණය කළ සම්පූර්ණ POS (Point of Sale) පද්ධතියක්.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "express": "node server.js",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.hardwarepos.app",
    "productName": "Hardware POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!scratch/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*",
      "backend/pos.db"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hardware POS",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
